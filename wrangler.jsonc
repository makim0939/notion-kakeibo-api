{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "notion-kakeibo-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-26",
	// "compatibility_flags": [
	//   "nodejs_compat"
	// ],
	"vars": {
		"NOTION_DATABASE_ID": "36aa4e54a1b58021a776e6a542910700",
		"NOTION_DATASOURCE_ID": "36aa4e54-a1b5-8072-bbd7-000b21cf4943",
		"NOTION_SUMMARY_DATA_SOURCE_ID": "36aa4e54-a1b5-8045-b743-000b3089b2ca"
	},
	// NOTION_API_KEY と API_KEY は秘匿値のため vars ではなく secret に置く。
	//   npx wrangler secret put NOTION_API_KEY
	//   npx wrangler secret put API_KEY
	// ローカル開発では .dev.vars（.dev.vars.example を参照）に書く。
	// "kv_namespaces": [
	//   {
	//     "binding": "MY_KV_NAMESPACE",
	//     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
	//   }
	// ],
	// "r2_buckets": [
	//   {
	//     "binding": "MY_BUCKET",
	//     "bucket_name": "my-bucket"
	//   }
	// ],
	// "d1_databases": [
	//   {
	//     "binding": "MY_DB",
	//     "database_name": "my-database",
	//     "database_id": ""
	//   }
	// ],
	// "ai": {
	//   "binding": "AI"
	// },
	// 毎時0分に、今月と前月のサマリページを最新化する。
	// 内容が変わっていなければ書き込まないので、空振りしても副作用はない。
	"triggers": {
		"crons": ["0 * * * *"]
	},

	// 構造化ログを Cloudflare のログ検索から追えるようにする。
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
